POSTGRES_DB=worldweave
POSTGRES_USER=worldweave
POSTGRES_PASSWORD=GENERATE_ON_FIRST_START
REGISTRATION_MODE=bootstrap_only
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
WORLDWEAVE_DOMAIN=:80
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
MEDIA_ROOT=/var/lib/worldweave/media
MAX_ASSET_BYTES=10485760
